# 공공데이터포털에서 발급한 한국관광공사 국문 관광정보 서비스 일반 인증키
TOUR_API_SERVICE_KEY=

# 광주광역시 기존 지역 코드. 새 법정동 코드 사용 시 아래 값을 비우고
# TOUR_API_LDONG_REGN_CD를 공공데이터포털의 ldongCode2 결과에 맞게 설정하세요.
TOUR_API_AREA_CODE=5
TOUR_API_LDONG_REGN_CD=

# 공공데이터포털 기상청 단기예보·중기예보 조회서비스 일반 인증키(두 서비스 모두 활용신청 필요)
# Encoding 또는 Decoding 키 모두 가능
KMA_API_SERVICE_KEY=

# AI 도슨트 제공자. 계획서 기준 기본값은 Gemini이며 openai로 전환할 수 있습니다.
# API 키는 config.js나 브라우저 코드에 넣지 않습니다.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI_PROVIDER=openai일 때 사용하는 선택 설정
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# AI Hub "한국 전통 문양 데이터"를 압축 해제한 저장소 밖 폴더의 절대경로.
# 원본 데이터는 프로젝트 폴더로 복사하거나 Git에 커밋하지 않습니다.
AIHUB_TRADITIONAL_PATTERN_DIR=
